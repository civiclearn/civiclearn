    {
      "segmentId": "hlu-09-s2",
      "type": "text",
      "title": "Öryggismál á Íslandi",
      "topic": "safety",
      "script": [
        {
          "speaker": "Lesari",
          "line": "Ísland er almennt mjög öruggt land. Glæpatíðni er lág og fólk treystir hvert öðru mikið. Margir læsa ekki bílana sína og börn ganga ein í skólann. En það er samt mikilvægt að gæta öryggis."
        },
        {
          "speaker": "Lesari",
          "line": "Náttúruhamfarir eru stærsta hættan á Íslandi. Eldgos, jarðskjálftar og stórir stormar geta gerst. Almannavarnir gefa út viðvaranir á vefsíðunni vedur.is og í appinu 112. Allir ættu að sækja 112 appið og kveikja á tilkynningum."
        },
        {
          "speaker": "Lesari",
          "line": "Ef eldgos verður nálægt gefur Almannavarnadeild ráðleggingar. Stundum þarf fólk að yfirgefa svæðið. Mikilvægt er að hafa neyðarbúnað heima: vatn, mat, vasaljós og rafhlöður. Rauði krossinn mælir með búnaði sem dugir í þrjá daga."
        }
      ],
      "ttsVoices": {
        "Lesari": "is-IS-GudrunNeural"
      },
      "questions": [
        {
          "questionId": "hlu-09-q05",
          "questionNumber": 5,
          "question": "Hver er stærsta hættan á Íslandi?",
          "options": [
            {
              "label": "A",
              "text": "Náttúruhamfarir"
            },
            {
              "label": "B",
              "text": "Glæpir"
            },
            {
              "label": "C",
              "text": "Umferðarslys"
            }
          ],
          "correctAnswer": "A"
        },
        {
          "questionId": "hlu-09-q06",
          "questionNumber": 6,
          "question": "Hvar gefa Almannavarnir út viðvaranir?",
          "options": [
            {
              "label": "A",
              "text": "Aðeins í sjónvarpinu"
            },
            {
              "label": "B",
              "text": "Á vedur.is og í 112 appinu"
            },
            {
              "label": "C",
              "text": "Aðeins í útvarpinu"
            }
          ],
          "correctAnswer": "B"
        },
        {
          "questionId": "hlu-09-q07",
          "questionNumber": 7,
          "question": "Hversu marga daga á neyðarbúnaður að duga?",
          "options": [
            {
              "label": "A",
              "text": "Einn dag"
            },
            {
              "label": "B",
              "text": "Eina viku"
            },
            {
              "label": "C",
              "text": "Þrjá daga"
            }
          ],
          "correctAnswer": "C"
        }
      ]
    },
    {
      "segmentId": "hlu-09-s3",
      "type": "text",
      "title": "Leigusamningur",
      "topic": "rental-contract",
      "script": [
        {
          "speaker": "Lesari",
          "line": "Þegar maður leigir íbúð á Íslandi er mikilvægt að hafa skriflegan leigusamning. Samningurinn á að innihalda nöfn leigusala og leigjanda, heimilisfang íbúðar, leiguverð og hvenær leiga er greidd."
        },
        {
          "speaker": "Lesari",
          "line": "Leigusamningurinn á líka að segja til um uppsagnarfrest. Venjulegur uppsagnarfrestur er þrír mánuðir. Það þýðir að ef leigjandi vill flytja þarf hann að tilkynna leigusala þremur mánuðum fyrirfram."
        },
        {
          "speaker": "Lesari",
          "line": "Ef vandamál koma upp á milli leigusala og leigjanda er hægt að leita til Húsnæðis- og mannvirkjastofnunar. Þeir geta hjálpað bæði aðilum. Einnig er hægt að fá ráðgjöf hjá Leigjendafélaginu á Íslandi. Þar kosta aðild aðeins nokkur þúsund krónur á ári."
        }
      ],
      "ttsVoices": {
        "Lesari": "is-IS-GunnarNeural"
      },
