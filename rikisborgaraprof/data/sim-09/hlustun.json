      "type": "dialogue",
      "title": "Hringja í 112",
      "topic": "emergency-call",
      "script": [
        {
          "speaker": "Neyðarlínan",
          "line": "Neyðarlínan, hvað er að?"
        },
        {
          "speaker": "Viðkomandi",
          "line": "Ég sá bílslys hérna á Miklubraut. Tveir bílar rákust saman."
        },
        {
          "speaker": "Neyðarlínan",
          "line": "Er einhver meiddur?"
        },
        {
          "speaker": "Viðkomandi",
          "line": "Ég held það. Konan í öðrum bílnum hreyfir sig ekki mikið."
        },
        {
          "speaker": "Neyðarlínan",
          "line": "Allt í lagi. Hvar nákvæmlega á Miklubraut eruð þið?"
        },
        {
          "speaker": "Viðkomandi",
          "line": "Rétt hjá Kringlunni, á vesturhlið gatnamotsins."
        },
        {
          "speaker": "Neyðarlínan",
          "line": "Gott. Sjúkrabíll er á leiðinni. Vertu hjá slysinu og talaðu við konuna ef þú getur. Ekki reyna að færa hana."
        },
        {
          "speaker": "Viðkomandi",
          "line": "Í lagi, ég verð hér. Ættu þið líka að senda lögreglu?"
        },
        {
          "speaker": "Neyðarlínan",
          "line": "Já, lögregla er líka á leiðinni. Þau koma innan fimm mínútna."
        }
      ],
      "ttsVoices": {
        "Neyðarlínan": "is-IS-GudrunNeural",
        "Viðkomandi": "is-IS-GunnarNeural"
      },
      "questions": [
