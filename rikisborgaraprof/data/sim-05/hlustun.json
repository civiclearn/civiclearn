      "topic": "restaurant",
      "script": [
        {
          "speaker": "Þjónn",
          "line": "Góðan daginn og velkomin. Borð fyrir tvo?"
        },
        {
          "speaker": "Gestur",
          "line": "Já, takk. Megum við sitja við gluggann?"
        },
        {
          "speaker": "Þjónn",
          "line": "Auðvitað. Hér er matseðillinn. Viltu eitthvað að drekka?"
        },
        {
          "speaker": "Gestur",
          "line": "Já, ég ætla að fá vatn og konan mín vill fá appelsínusafa."
        },
        {
          "speaker": "Þjónn",
          "line": "Í lagi. Erum við tilbúin að panta?"
        },
        {
          "speaker": "Gestur",
          "line": "Ég ætla að fá fiskréttinn með kartöflum. Hvað mælir þú með fyrir hana?"
        },
        {
          "speaker": "Þjónn",
          "line": "Lambahryggirínn er mjög vinsæll í dag. Hann kemur með grænmeti og sósu."
        },
        {
          "speaker": "Gestur",
          "line": "Hún tekur lambahrygginn. Og gætum við fengið brauð á meðan við bíðum?"
        },
        {
          "speaker": "Þjónn",
          "line": "Já, ég koma með brauð strax. Viltu eitthvað annað?"
        },
        {
          "speaker": "Gestur",
          "line": "Nei takk, þetta er komið. Takk fyrir."
        }
