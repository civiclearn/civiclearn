      "type": "dialogue",
      "title": "Í símtali við heilsugæsluna",
      "topic": "booking-appointment",
      "script": [
        {
          "speaker": "Starfsmaður",
          "line": "Heilsugæslustöðin Árbær, góðan daginn."
        },
        {
          "speaker": "Sjúklingur",
          "line": "Góðan daginn. Mig langar að panta tíma hjá heimilislækninum mínum."
        },
        {
          "speaker": "Starfsmaður",
          "line": "Já, hver er læknirinn þinn?"
        },
        {
          "speaker": "Sjúklingur",
          "line": "Hún heitir Sigríður Jónsdóttir."
        },
        {
          "speaker": "Starfsmaður",
          "line": "Sigríður er ekki á stofunni í dag. Hún kemur aftur á mánudaginn. Viltu bíða eða hitta annan lækni?"
        },
        {
          "speaker": "Sjúklingur",
          "line": "Ég get ekki beðið. Ég er mjög slæmur og þarf að hitta lækni í dag."
        },
        {
          "speaker": "Starfsmaður",
          "line": "Allt í lagi. Doktor Björn er laus klukkan hálfþrjú. Hentar það?"
        },
        {
          "speaker": "Sjúklingur",
          "line": "Já, það hentar vel. Þarf ég að borga?"
        },
        {
          "speaker": "Starfsmaður",
          "line": "Já, það kostar tvö þúsund krónur. Þú borgar við komuna."
        },
        {
          "speaker": "Sjúklingur",
          "line": "Gott. Ég kem klukkan hálfþrjú. Takk fyrir."
        }
      ],
      "ttsVoices": {
        "Starfsmaður": "is-IS-GudrunNeural",
